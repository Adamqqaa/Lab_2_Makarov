<Window x:Class="Lab_2.Windows.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_2.Windows"
        mc:Ignorable="d"
        Title="Авторизированный клиент" Width="560" Height="360"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>
    <Grid Background="#E8F5E9">
        <Border Width="490" Height="302" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="0" Padding="30"
                BorderBrush="#C5E1C5" BorderThickness="1">
            <StackPanel Margin="0,0,0,-37">
                <TextBlock Text="Форма клиента" FontSize="24" FontWeight="SemiBold"
                           Foreground="#2E7D32" HorizontalAlignment="Center"/>
                <TextBlock Text="Личный кабинет авторизированного клиента" Foreground="#8A8A8A"
                           HorizontalAlignment="Center" Margin="0,2,0,14"/>

                <TextBlock x:Name="TxtFullName" Style="{StaticResource InfoText}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtLogin" Style="{StaticResource InfoText}"/>
                <TextBlock x:Name="TxtRole" Style="{StaticResource InfoText}" Foreground="#2E7D32" FontWeight="SemiBold" Margin="0,10,0,0"/>

                <Button Content="Выйти" Height="38" FontSize="15" Margin="0,24,0,0"
                        HorizontalAlignment="Right" Width="120"
                        Click="BtnLogout_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>